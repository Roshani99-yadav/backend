# SMTP connection details for your outgoing mail provider.
# Defaults below match Hostinger's recommended settings — see the
# "Using Hostinger Email" section in README.md for where to find these
# in hPanel and for the port 587 (STARTTLS) alternative.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# The Hostinger mailbox that authenticates and sends the mail.
# Hostinger requires the "From" address to match this account, so this
# should be a real mailbox you created in hPanel > Emails (e.g. website@yourdomain.com).
SMTP_USER=your_email@yourdomain.com
SMTP_PASS=your_email_account_password

# Inbox that receives new enquiries — can be the same as SMTP_USER or a different address.
MAIL_TO=sales@aarvicontrol.com

# Port this Express server listens on.
PORT=5000

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGIN=https://aarvisac.com,http://localhost:5173,http://localhost:3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aarvisac_blog
